{
  // Default OpenCode configuration seeded by opencode-sandbox on first run
  // (source of truth for src/podman.rs: DEFAULT_OPENCODE_CONFIG).
  //
  // Edit this file on the HOST. In a normal (locked) run every config entry is
  // additionally mounted read-only (except the regular runtime-writable
  // cli.json, service.json and tui.json), so an agent cannot change its own
  // permissions
  // or config even via shell. Nix-managed symlinks are mounted read-only even
  // with --edit-config; regular config files are writable in that mode. The
  // deny policies below survive project-level config and approvals either way.
  "$schema": "https://opencode.ai/config.json",

  // --- Permissions (V2 rules; ordered, last match wins) ---
  //
  // Minimal by design: the base policy already allows everything by default
  // (prompting only for external directories and .env reads). The rules below
  // change that: pushes to the host repo are always blocked (the workspace is
  // host-mounted, so a push outlives the sandbox), external-directory prompts
  // are silenced -- the rootfs is an immutable ephemeral image, the toolchain
  // caches are not secrets, and real credentials are hard-denied by policies
  // below, never asked about -- and /tmp stays writable.
  //
  // The plan agent denies edits except under ~/.opencode/plan. /tmp is
  // ephemeral scratch (tmpfs in this image), so allowing edits there keeps
  // plan mode's "no persistent project changes" guarantee intact. This is a
  // global rule rather than an `agents.plan.permissions` override: global
  // rules are evaluated after the agent's built-in defaults (last match wins),
  // so it applies to the plan agent too. The seed deliberately defines no
  // agent entries: a seeded agent would override the user's own `agents`
  // configuration, while the top-level rule already covers plan mode.
  "permissions": [
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "external_directory", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "/tmp/*", "effect": "allow" }
  ],

  // Policies are a hard-deny layer: they run after permission rules and saved
  // "allow always" approvals, and project configs cannot lift them. They
  // guard host secrets and opencode's own state -- cargo registry and opencode
  // auth credentials (auth.json, account.json, service.json), the host git
  // config, the session database, and the shell/tool output archives -- from
  // the agent's tools. All denies are silent, so this layer costs nothing in
  // normal work.
  "policies": [
    { "action": "tool.use", "resource": "edit:/opencode/data/opencode/auth.json", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:/opencode/data/opencode/account.json", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:/opencode/config/opencode/service.json", "effect": "deny" },
    { "action": "tool.use", "resource": "read:/opencode/config/opencode/service.json", "effect": "deny" },
    { "action": "tool.use", "resource": "read:/opencode/data/opencode/auth.json", "effect": "deny" },
    { "action": "tool.use", "resource": "read:/opencode/data/opencode/account.json", "effect": "deny" },
    // Cargo registry credentials (crates.io tokens) are host secrets: hard-
    // deny their read instead of asking so they never reach the agent.
    { "action": "tool.use", "resource": "read:/opencode/cargo/credentials*", "effect": "deny" },
    // The host git config (ro-mounted at /opencode/config/git) can embed
    // credentials (insteadOf URLs, http.extraheader headers): read-deny it.
    { "action": "tool.use", "resource": "read:/opencode/config/git/*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:/opencode/data/opencode/shell/*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:/opencode/data/opencode/tool-output/*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:/opencode/state/opencode/service.json", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:/opencode/state/opencode/service.json", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:/opencode/data/opencode/opencode.db*", "effect": "deny" },
    // Reading the session DB would pull every prior session into context:
    // read-deny it too (shell access is unaffected).
    { "action": "tool.use", "resource": "read:/opencode/data/opencode/opencode.db*", "effect": "deny" }
  ]
}
